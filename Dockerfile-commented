###############################################################################
# Hadoop Single Node Setup - Dockerfile
# 
# This Dockerfile creates an environment for running a single-node Hadoop cluster
# suitable for development and testing purposes.
###############################################################################

# Base image: Ubuntu 20.04 LTS
# We use Ubuntu as it provides good compatibility with Hadoop components
FROM ubuntu:20.04

# Set environment variables
# DEBIAN_FRONTEND=noninteractive prevents interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Update package lists and install required dependencies:
# - openjdk-8-jdk: Java Development Kit required by Hadoop
# - wget: Used for downloading files
# - ssh: Required for Hadoop services communication
# - pdsh: Parallel distributed shell for cluster management
# - nano: Simple text editor for configuration files
# We clean up the apt cache to reduce image size
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    openjdk-8-jdk \
    wget \
    ssh \
    pdsh \
    nano \
    && rm -rf /var/lib/apt/lists/*

# Copy the Hadoop installation script into the container
# This script will be executed to set up Hadoop when the container starts
COPY install-hadoop.sh /install-hadoop.sh

# Make the installation script executable
RUN chmod +x /install-hadoop.sh

# Expose necessary Hadoop ports to the host:
# - 9870: NameNode web UI
# - 8088: ResourceManager web UI
# - 9864: DataNode web UI
# - 9000: HDFS default FS port
# - 22: SSH port for inter-service communication
EXPOSE 9870 8088 9864 9000 22

# Define the container's entry point
# When the container starts, it will run the Hadoop installation script
CMD ["/bin/bash", "/install-hadoop.sh"] 